{
  "name": "custodia-sync-backend",
  "version": "2.0.0",
  "description": "Custódia: servidor de sincronização zero-knowledge",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
