{
  "name": "custodia",
  "version": "0.2.0",
  "description": "Custódia, gerenciador de senhas para Android",
  "private": true,
  "scripts": {
    "start": "react-native start --port 8082",
    "android": "react-native run-android --port 8082",
    "android:release": "react-native run-android --mode release",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "bundle:check": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build-check/index.android.bundle --assets-dest build-check/res"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@op-engineering/op-sqlite": "18.2.4",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/stack": "^7.11.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^8.19.0",
    "eslint-plugin-sonarjs": "0.25.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "op-sqlite": {
    "sqlcipher": true
  }
}
